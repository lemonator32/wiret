wiret 1
module lessons.events

extern func host.Log(message: string)

#[doc("A button that tells whoever is listening when it is clicked.")]
class Button {
  dispatcher OnClick(times: i32)

  #[note("Click counts its clicks in a state slot, which every button keeps for itself, then tells every listener with Broadcast.")]
  func Click() {
    state clicks: i32

    flow {
      entry -> save
      save -> tell
    }

    node entry = Entry()
    node save = SetState clicks(
      .value <- Add::<i32>(
        .a <- GetState clicks(),
        .b <- 1,
      ),
    )
    node tell = Broadcast Button.OnClick(
      .obj <- entry.self,
      .times <- GetState clicks(),
    )

    layout {
      entry at (0, 0)
      save at (250, 0)
      save.value at (50, 110)
      save.value.a at (-141, 110)
      tell at (500, 0)
      tell.times at (300, 110)
    }
  }
}

#[doc("Counts the clicks it hears.")]
class Counter {
  heard: i32

  #[note("Heard is a handler: its inputs match OnClick, so it can listen to a button.")]
  func Heard(times: i32) {
    flow {
      entry -> save
    }

    node entry = Entry()
    node save = SetField Counter.heard(
      .obj <- entry.self,
      .value <- Add::<i32>(
        .a <- GetField Counter.heard(
          .obj <- entry.self,
        ),
        .b <- 1,
      ),
    )

    layout {
      entry at (0, 0)
      save at (581, 0)
      save.value at (393, 78)
      save.value.a at (213, 78)
    }
  }
}

#[note("Announce is another handler, a plain function this time.")]
func Announce(times: i32) {
  flow {
    entry -> say
  }

  node entry = Entry()
  node say = Call host.Log(
    .message <- Call std.string.Concat(
      .a <- "Click number ",
      .b <- Convert::<i32, string>(
        .value <- entry.times,
      ),
    ),
  )

  layout {
    entry at (0, 0)
    say at (719, 0)
    say.message at (452, 53)
    say.message.b at (185, 73)
  }
}

#[note("Lesson 14: Events. A dispatcher is a list of listeners on an object: Bind adds one, Unbind removes one, and Broadcast calls them all. A listener is a delegate, made with CreateDelegate from a function, or from a method plus the object to call it on.")]
#[note("Try it: (1) Move the Unbind to the end: Announce hears all three clicks. (2) Make a second Counter and bind it too. (3) Change Heard to an event with a Delay: a delegate starts an event on its own, so Click does not wait.")]
func Main() {
  flow {
    b -> c
    bind_a -> bind_c
    bind_c -> click1
    c -> bind_a
    click1 -> click2
    click2 -> unbind_a
    click3 -> say
    entry -> b
    unbind_a -> click3
  }

  node announce = CreateDelegate Announce()
  node b = New Button()
  node bind_a = Bind Button.OnClick(
    .obj <- b,
    .handler <- announce,
  )
  node bind_c = Bind Button.OnClick(
    .obj <- b,
    .handler <- CreateDelegate Counter.Heard(
      .target <- c,
    ),
  )
  node c = New Counter()
  node click1 = Call Button.Click(
    .self <- b,
  )
  node click2 = Call Button.Click(
    .self <- b,
  )
  node click3 = Call Button.Click(
    .self <- b,
  )
  node entry = Entry()
  node say = Call host.Log(
    .message <- Call std.string.Concat(
      .a <- "The counter heard ",
      .b <- Call std.string.Concat(
        .a <- Convert::<i32, string>(
          .value <- GetField Counter.heard(
            .obj <- c,
          ),
        ),
        .b <- " clicks",
      ),
    ),
  )
  node unbind_a = Unbind Button.OnClick(
    .obj <- b,
    .handler <- announce,
  )

  layout {
    announce at (381, 214)
    b at (250, 0)
    bind_a at (750, 0)
    bind_c at (1000, 0)
    bind_c.handler at (698, 154)
    c at (500, 0)
    click1 at (1250, 0)
    click2 at (1500, 0)
    click3 at (2000, 0)
    entry at (0, 0)
    say at (2250, 0)
    say.message at (1981, 141)
    say.message.b at (1764, 161)
    say.message.b.a at (1522, 161)
    say.message.b.a.value at (1276, 161)
    #[note("After this, Announce stops listening, but the counter goes on.")]
    unbind_a at (1750, 0)
  }
}
