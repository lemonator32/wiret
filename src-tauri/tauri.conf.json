{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wiret",
  "version": "0.12.0",
  "identifier": "dev.wiret.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wiret",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["wiret"], "name": "Wiret program", "description": "Wiret program", "role": "Editor", "mimeType": "text/x-wiret" }
    ],
    "category": "DeveloperTool",
    "shortDescription": "Wiret graph editor",
    "longDescription": "A visual scripting editor whose graphs are plain, diff-friendly text, with a compiler, verifier, VM and stepping debugger."
  }
}
